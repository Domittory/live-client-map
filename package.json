{
  "name": "living-client-map",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:acceptance": "vitest run tests/acceptance",
    "test:integration": "vitest run tests/integration",
    "test:integration:release": "vitest run --no-file-parallelism tests/integration",
    "test:e2e": "playwright test",
    "security:audit": "node scripts/security-audit.mjs",
    "audit:writes": "node scripts/check-unsafe-audit-writes.mjs",
    "audit:rpc-permissions": "node scripts/check-rpc-permissions.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:types:check": "node scripts/db-types-check.mjs --check",
    "verify": "pnpm audit:writes && pnpm audit:rpc-permissions && pnpm db:types:check",
    "release:check": "node scripts/release-check.mjs",
    "release:check:static": "node scripts/release-check.mjs --phase static",
    "release:check:database": "node scripts/release-check.mjs --phase database",
    "release:checklist": "node scripts/check-release-checklist.mjs",
    "release:checklist:complete": "node scripts/check-release-checklist.mjs --require-complete",
    "release:ai-gate": "node scripts/check-production-ai.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss@<=8.5.22": "8.5.26"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "15.5.25",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
