# Supabase — local development (ticket 01: Supabase CLI + Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the Supabase CLI for migrations.
# Local default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# AI gateway (ticket 32) — server-only, never exposed to the browser.
# fake (default) | openai. OpenAI requires OPENAI_API_KEY and is dev/test only.
AI_PROVIDER=fake
OPENAI_API_KEY=
# Production AI stays disabled until a separate provider/data-region decision.
AI_PRODUCTION_ENABLED=false
